# Local PostgreSQL/PostGIS settings used by Docker Compose and the Python code.
# Copy this file to .env and choose a password before starting PostgreSQL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=change-this-local-password

# Optional isolated clean-room database beside an existing installation:
# POSTGRES_PORT=55432
# POSTGRES_CONTAINER_NAME=capstone_cleanroom_postgres
# COMPOSE_PROJECT_NAME=capstone_cleanroom

# Spatial safety margin around the Berlin planning-area footprint.
WEATHER_MASK_BUFFER_M=5000

# Keep operational forecast rows and source files for at most 24 hours.
# Choose a whole number from 1 through 24; the default is 24.
FORECAST_RETENTION_HOURS=24

# DAGSTER_HOME must be an absolute path. Before starting Dagster, run:
# export DAGSTER_HOME="$PWD/.dagster_home"
